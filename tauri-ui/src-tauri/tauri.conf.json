{
  "productName": "PC GamePak",
  "version": "1.2.0",
  "identifier": "com.pc-gamepak.launcher",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://steamgriddb.com https://*.steamgriddb.com https://cdn.steamgriddb.com https://cdn2.steamgriddb.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
